APP_ENV=development
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
CORS_ORIGINS=http://localhost:3000

# Prefer Session pooler on Windows/IPv4 networks:
# Supabase → Project Settings → Database → Connection string → Pooler (Session)
DATABASE_HOST=aws-0-YOUR_REGION.pooler.supabase.com
DATABASE_USER=postgres.YOUR_PROJECT_REF
DATABASE_NAME=postgres
DATABASE_PORT=5432
DATABASE_PASSWORD=your-database-password

# Or full URL (URL-encode special password chars). Prefer HOST+PASSWORD above.
DATABASE_URL=
